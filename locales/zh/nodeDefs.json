{
  "LKH3Studio": {
    "display_name": "MiniMaxH3长视频操作台（LK)",
    "inputs": {
      "clip_name": {
        "name": "CLIP模型"
      },
      "video_vae_name": {
        "name": "视频 VAE"
      },
      "audio_vae_name": {
        "name": "音频 VAE"
      },
      "aspect": {
        "name": "宽高比例",
        "options": {
          "adaptive": "自适应",
          "16:9": "16:9",
          "9:16": "9:16",
          "3:2": "3:2",
          "2:3": "2:3",
          "4:3": "4:3",
          "3:4": "3:4",
          "1:1": "1:1",
          "21:9": "21:9"
        }
      },
      "megapixels": {
        "name": "百万像素"
      },
      "prompt_override": {
        "name": "提示词"
      },
      "refmods_json": {
        "name": "RefMod 列表"
      },
      "segments_json": {
        "name": "分段配置"
      },
      "ref_image_size": {
        "name": "Reference image size"
      },
      "audio_mode": {
        "name": "音频参考模式",
        "options": {
          "lock_source": "原声输出",
          "reference_only": "音色参考",
          "native": "自由生成"
        }
      }
    },
    "outputs": {
      "0": {
        "name": "segments"
      }
    }
  },
  "LKH3LongVideo": {
    "display_name": "MiniMax-H3 长视频分段采样（LK）",
    "inputs": {
      "model": {
        "name": "模型"
      },
      "segments": {
        "name": "分段计划"
      },
      "steps": {
        "name": "步数"
      },
      "shift_video": {
        "name": "视频偏移"
      },
      "shift_audio": {
        "name": "音频偏移"
      },
      "sampler_name": {
        "name": "采样器"
      },
      "scheduler": {
        "name": "调度器"
      },
      "seed": {
        "name": "种子"
      },
      "seed_policy": {
        "name": "分段种子策略"
      },
      "cfg": {
        "name": "CFG"
      },
      "release_clip": {
        "name": "分段间释放文本编码器"
      },
      "free_between_segments": {
        "name": "分段间释放缓存"
      },
      "context_noise": {
        "name": "Context noise"
      },
      "refine_latent": {
        "name": "二跑潜空间",
        "tooltip": "接放大后的 AV 潜空间（本节点 av_latent → AV潜空间放大 → 此口）。连接后本节点以截断调度对放大潜空间做低噪二跑（高清化），而不是重新生成。一跑必须跑满全部分段范围。"
      },
      "refine_denoise": {
        "name": "二跑去噪强度",
        "tooltip": "截断调度的起始 sigma（= 去噪强度）。0.3–0.5 可锐化放大后的潜空间；1.0 等于完全重采。一跑忽略。"
      },
      "refine_audio": {
        "name": "二跑音频",
        "options": {
          "keep": "保留一跑音频",
          "regenerate": "重新生成音频"
        },
        "tooltip": "二跑音频策略。keep：锁定一跑音频（逐位一致）。regenerate：音频也参与低噪重采。一跑忽略。"
      }
    },
    "outputs": {
      "0": {
        "name": "图像"
      },
      "1": {
        "name": "音频"
      },
      "2": {
        "name": "尾帧"
      },
      "3": {
        "name": "报告"
      },
      "4": {
        "name": "分段信息"
      },
      "5": {
        "name": "AV 潜空间",
        "tooltip": "执行范围的全片打包 AV 潜空间（含 lk_layout 布局元数据）。接 AV潜空间放大 后回灌 refine_latent 做高清二跑。"
      }
    }
  },
  "LKH3AVUpscale": {
    "display_name": "MiniMax-H3 AV潜空间放大（LK）",
    "description": "对打包 AV 潜空间的视频部分做空间插值，音频与布局元数据原样透传。链路：长视频采样 av_latent → 本节点 → 长视频采样 refine_latent。",
    "inputs": {
      "av_latent": {
        "name": "AV 潜空间",
        "tooltip": "长视频采样节点 av_latent 输出的打包 AV 潜空间。"
      },
      "upscale_method": {
        "name": "插值方法",
        "options": {
          "nearest-exact": "最近邻",
          "bilinear": "双线性",
          "area": "区域平均",
          "bicubic": "双三次",
          "lanczos": "Lanczos"
        },
        "tooltip": "应用于视频潜空间（及其 mask）的插值方式。"
      },
      "scale_by": {
        "name": "放大倍数",
        "tooltip": "空间放大倍数。默认 2.0 把 0.5MP 基础画布带到 H3 训练上限（约 1920×1088）。二跑每段算力约为倍数的平方。"
      }
    },
    "outputs": {
      "0": {
        "name": "AV 潜空间",
        "tooltip": "放大后的打包 AV 潜空间；接长视频采样节点的 refine_latent。"
      }
    }
  },
  "LKH3Settings": {
    "display_name": "MiniMaxH3模型设置（LK)",
    "description": "全局模型与画布设置；输出连接到分镜编排节点的模型设置输入。",
    "inputs": {
      "clip_name": { "name": "CLIP模型" },
      "video_vae_name": { "name": "视频 VAE" },
      "audio_vae_name": { "name": "音频 VAE" },
      "aspect": {
        "name": "宽高比例",
        "options": {
          "adaptive": "自适应",
          "16:9": "16:9",
          "9:16": "9:16",
          "3:2": "3:2",
          "2:3": "2:3",
          "4:3": "4:3",
          "3:4": "3:4",
          "1:1": "1:1",
          "21:9": "21:9"
        }
      },
      "megapixels": { "name": "百万像素" },
      "ref_image_size": {
        "name": "参考素材尺寸",
        "options": {
          "match": "匹配",
          "1.2x": "1.2倍",
          "1.5x": "1.5倍",
          "2x": "2倍",
          "max": "最大值"
        }
      },
      "audio_mode": {
        "name": "音频参考模式",
        "options": {
          "lock_source": "原生输出",
          "reference_only": "仅参考音频",
          "native": "自由生成"
        }
      }
    },
    "outputs": {
      "0": {
        "name": "模型设置",
        "tooltip": "连接到 MiniMaxH3分镜编排 节点的模型设置输入。"
      }
    }
  },
  "LKH3Shots": {
    "display_name": "MiniMaxH3分镜编排（LK)",
    "description": "八个固定分镜板块与逐镜头连线点；与 MiniMaxH3模型设置 节点搭配使用，输出接长视频采样节点。",
    "inputs": {
      "settings": { "name": "模型设置" },
      "latent_continue": { "name": "潜空间续接" },
      "range_start": { "name": "运行范围·起" },
      "range_end": { "name": "运行范围·止" },
      "conn_first_frame": { "name": "首帧（连线）" },
      "conn_last_frame": { "name": "尾帧（连线）" },
      "conn_image": { "name": "参考图片（连线）" },
      "conn_video": { "name": "参考视频（连线）" },
      "conn_audio": { "name": "参考音频（连线）" }
    },
    "outputs": {
      "0": {
        "name": "segments",
        "tooltip": "长视频分镜计划；接长视频采样节点。"
      }
    }
  }
}
